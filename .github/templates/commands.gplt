+{{ define "renderCommandDocs" }}
    +{{- $level := 4 -}}

    +{{- $files := walkDir "~/" -}}
    +{{- range $files -}}
        +{{- if eq (fileExt .) ".go" -}}
            +{{- $source := readRaw . -}}
            +{{- $decls := call "parseFuncDeclarations" $source -}}
            +{{- if eq (len $decls) 0 -}}
                +{{- continue -}}
            +{{- end -}}
            +{{- call "renderCommandSection" . $decls $level -}}
        +{{- end -}}
    +{{- end -}}
+{{ end }}

+{{ define "renderCommandSection(path, declarations, level)" }}
+{{- $pathNoExt := trimSuffix .path ".go" -}}
+{{- $filename := basePath $pathNoExt -}}
+{{- $decls := .declarations -}}
+{{- $level := .level -}}

<h+{{ sub $level 1 }}><a href="+{{ concat "https://github.com/codeshelldev/goplater/blob/main/" (afterLast .path "goplater/" ) }}">+{{ $filename }}</a></h+{{ sub $level 1 }}>
+{{ range $decl := $decls -}}

    +{{ call "renderCommand" $decl $level }}
+{{- end -}}
+{{ end }}

+{{ define "renderCommand(declaration, level)" }}
+{{- $decl := .declaration }}

<table width="100%">
<tr><th align="left"><h+{{ .level }}><code>
+{{- index $decl "name" -}}

+{{- $paramsStr := "" -}}
+{{- if gt (len (index $decl "params")) 0 -}}
    +{{- $params := list -}}
    +{{- range $param := index $decl "params" -}}
        +{{- $param = join " " (index $param "name") (index $param "type") }}
        +{{- $params = append $params $param -}}
    +{{- end -}}
    +{{- $paramsStr = join ", " $params -}}
+{{- end -}}
(+{{- $paramsStr -}})

+{{- $returns := (index $decl "returns") -}}
+{{- if gt (len $returns) 0 -}}
    +{{- $returnStr := join ", " $returns -}}
    +{{- if gt (len $returns) 1 -}}
        +{{- $returnStr = concat "(" $returnStr ")" -}}
    +{{- end }} +{{ $returnStr -}}
+{{- end}}</code></h+{{ .level}}></th>
</tr><tr><td>
+{{ markdownHTML (markdownDecode (index $decl "summary")) }}
+{{ $examples := index $decl "examples" -}}
+{{- if gt (len $examples) 0 }}
<details>
  <summary>Examples</summary>
  <br/>
+{{- range $i, $example := $examples }}

**Example**:
```handlebars
+{{ $example }}
```
+{{- $outputs := (index $decl "outputs") -}}
+{{- if gt (len $outputs) $i }}
**Output**:
```
+{{ index $outputs $i }}
```
+{{ end -}}
+{{- end }}

</details>
+{{ end }}
</td></tr></table>
+{{ end }}

+{{ define "parseFuncDeclarations(content)" }}
    +{{ $pattern := `(?ms)((?:^[ \t]*//[^\r\n]*(?:\r?\n|$))+)[ \t]*var[ \t]+[a-zA-Z_][a-zA-Z0-9_]*[ \t]*=[ \t]*modules\.NewFunc\([ \t]*"([a-zA-Z_][a-zA-Z0-9_]*)"[ \t]*,[^)]*\)` }}
    +{{ $matches := regexFindGroups $pattern .content }}
    +{{ $entries := list }}
    +{{ range $match := $matches }}
        +{{ $entry := call "parseFuncDeclaration" (index $match 2) (index $match 1) }}
        +{{ $entries = append $entries $entry }}
    +{{ end }}

    +{{ return $entries }}
+{{ end }}

+{{ define "parseFuncDeclaration(name, comment)"}}
    +{{ $summary := call "parseFuncSummary" .comment }}
    +{{ $params := call "parseFuncParams" .comment }}
    +{{ $returns := call "parseFuncReturns" .comment }}
    +{{ $examples := call "parseFuncExamples" .comment }}
    +{{ $outputs := call "parseFuncOutputs" .comment }}

    +{{ return (dict "name" .name "summary" $summary "params" $params "returns" $returns "examples" $examples "outputs" $outputs) }}
+{{ end }}

+{{ define "parseFuncSummary(content)" }}
    +{{ $lines := split .content "\n" }}
    +{{ $summary := list }}
    +{{ range $line := $lines }}
        +{{ $line = after $line "//"}}
        +{{ $line = trimSpace $line }}

        +{{ if eq $line "" }}
            +{{ break }}
        +{{ end }}

        +{{ if regexMatch `^@(param|throws|returns|example|output)\b` $line }}
            +{{ break }}
        +{{ end }}

        +{{ $summary = append $summary $line }}
    +{{ end }}

    +{{ return (join "\n" $summary) }}
+{{ end }}

+{{ define "parseFuncParams(content)"}}
    +{{ $lines := split .content "\n" }}
    +{{ $params := list }}
    +{{ $pattern := `^@param\s+(\S+)\s+(.*)$` }}
    +{{ range $line := $lines }}
        +{{ $line = after $line "//"}}
        +{{ $line = trimSpace $line }}

        +{{ if eq $line "" }}
            +{{ continue }}
        +{{ end }}

        +{{ if regexMatch $pattern $line }}
            +{{ $match := index (regexFindGroups $pattern $line) 0 }}
            +{{ $entry := dict "name" (index $match 1) "type" (index $match 2) }}
            +{{ $params = append $params $entry }}
        +{{ end }}
    +{{ end }}

    +{{ return $params }}
+{{ end }}

+{{ define "parseFuncReturns(content)"}}
    +{{ $lines := split .content "\n" }}
    +{{ $returns := list }}
    +{{ $pattern := `^@returns\s+(.*)$` }}
    +{{ range $line := $lines }}
        +{{ $line = after $line "//"}}
        +{{ $line = trimSpace $line }}

        +{{ if eq $line "" }}
            +{{ continue }}
        +{{ end }}

        +{{ if regexMatch $pattern $line }}
            +{{ $match := index (regexFindGroups $pattern $line) 0 }}
            +{{ $type := index $match 1 }}
            +{{ if eq $type "error" }}
                +{{ $type = "throws error" }}
            +{{ end }}
            +{{ $returns = append $returns $type }}
        +{{ end }}
    +{{ end }}

    +{{ return $returns }}
+{{ end }}

+{{ define "parseFuncExamples(content)" }}
    +{{ $lines := split .content "\n" }}
    +{{ $examples := list }}
    +{{ $i := 0 }}
    +{{ $inExample := false }}
    +{{ range $line := $lines }}
        +{{ $line = after $line "//"}}
        +{{ $line = trimSpace $line }}

        +{{ if eq $line "" }}
            +{{ if eq $inExample true }}
                +{{ $i = add $i 1 }}
            +{{ end }}
            +{{ $inExample = false }}
            +{{ continue }}
        +{{ end }}

        +{{ if regexMatch `^@(param|returns|output)\b` $line }}
            +{{ if eq $inExample true }}
                +{{ $i = add $i 1 }}
            +{{ end }}
            +{{ $inExample = false }}
            +{{ continue }}
        +{{ end }}

        +{{ if regexMatch `^@example\b` $line }}
            +{{ $inExample = true }}
            +{{ continue }}
        +{{ end }}

        +{{ if eq $inExample false }}
            +{{ continue }}
        +{{ end }}

        +{{ if lt $i (len $examples) }}
            +{{ $collected := index $examples $i }}
            +{{ set $examples $i (join "\n" $collected $line) }}
        +{{ else }}
            +{{ $examples = append $examples $line }}
        +{{ end }}
    +{{ end }}

    +{{ return $examples }}
+{{ end }}

+{{ define "parseFuncOutputs(content)" }}
    +{{ $lines := split .content "\n" }}
    +{{ $outputs := list }}
    +{{ $i := 0 }}
    +{{ $inOutput := false }}
    +{{ range $line := $lines }}
        +{{ $line = after $line "//"}}
        +{{ $line = trimSpace $line }}

        +{{ if eq $line "" }}
            +{{ if eq $inOutput true }}
                +{{ $i = add $i 1 }}
            +{{ end }}
            +{{ $inOutput = false }}
            +{{ continue }}
        +{{ end }}

        +{{ if regexMatch `^@(param|returns|example)\b` $line }}
            +{{ if eq $inOutput true }}
                +{{ $i = add $i 1 }}
            +{{ end }}
            +{{ $inOutput = false }}
            +{{ continue }}
        +{{ end }}

        +{{ if regexMatch `^@output\b` $line }}
            +{{ $inOutput = true }}
            +{{ continue }}
        +{{ end }}

        +{{ if eq $inOutput false }}
            +{{ continue }}
        +{{ end }}

        +{{ if lt $i (len $outputs) }}
            +{{ $collected := index $outputs $i }}
            +{{ set $outputs $i (join "\n" $collected $line) }}
        +{{ else }}
            +{{ $outputs = append $outputs $line }}
        +{{ end }}
    +{{ end }}

    +{{ return $outputs }}
+{{ end }}
