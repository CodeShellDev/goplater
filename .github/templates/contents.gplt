+{{ define "renderContentSection(html, level)" }}
+{{- $document := htmlDecode .html -}}

+{{- $items := call "collectHeadingChildren" $document .level -}}

+{{- $lines := sliceCreate }}

+{{- range $item := $items -}}
+{{- $text := htmlText $item -}}
+{{- $line := (concat "- [" $text "](#" (call "generateHeadingAnchor" $text) ")") -}}
+{{- $lines = slicePush $lines $line -}}
+{{- end -}}

+{{- join "\n" $lines -}}
+{{ end }}

+{{ define "indentTabs(text, indent)" }}
    +{{ $prefix := repeat "\t" .indent }}
    +{{ returnNext (regexReplace .text `(?m)^` $prefix) }}
+{{ end }}

+{{ define "generateHeadingAnchor(text)" }}
    +{{ $text := .text }}

    +{{ $text = lower $text }}
    +{{ $text = regexReplace $text "`" "" }}
    +{{ $text = regexReplace $text `[^a-z0-9\s-]` "" }}
    +{{ $text = regexReplace $text `\s+` "-" }}
    +{{ $text = regexReplace $text `-+` "-" }}
    +{{ $text = trim $text "-" }}

    +{{ returnNext $text }}
+{{ end }}

+{{ define "collectHeadingChildren(document, level)" }}
    +{{ $result := sliceCreate }}
    +{{ $level := .level }}

    +{{ range $element := htmlDocFindAll .document (concat "h" (toString $level)) }}
        +{{ $result = slicePush $result $element }}
    +{{ end }}

    +{{ returnNext $result }}
+{{ end }}