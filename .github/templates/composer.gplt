+{{ define "templates(path)" }}
    +{{ return (read (concat "~/.github/templates/" .path)) }}
+{{ end }}

+{{ define "section(path)" }}
    +{{ return (call "templates" (concat "sections/" .path ".md")) }}
+{{ end }}

+{{ define "example(path)" }}
    +{{ return (read (concat "~/examples/" .path ".md")) }}
+{{ end }}

+{{ define "exampleRaw(path)" }}
    +{{ return (readRaw (concat "~/examples/" .path ".md")) }}
+{{ end }}